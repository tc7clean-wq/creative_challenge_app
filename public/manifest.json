{
  "name": "AI ArtVerse - AI Art Competition Platform",
  "short_name": "AI ArtVerse",
  "description": "Join the future of digital art. Submit AI-generated artwork, compete in challenges, and connect with artists worldwide.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#00f7ff",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["art", "creativity", "social", "competition"],
  "shortcuts": [
    {
      "name": "Submit Artwork",
      "short_name": "Submit",
      "description": "Submit your AI-generated artwork to competitions",
      "url": "/submit",
      "icons": [
        {
          "src": "/icons/submit-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Browse Gallery",
      "short_name": "Gallery",
      "description": "Explore amazing AI-generated artworks",
      "url": "/gallery",
      "icons": [
        {
          "src": "/icons/gallery-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Active Contests",
      "short_name": "Contests",
      "description": "View and join active art competitions",
      "url": "/contests",
      "icons": [
        {
          "src": "/icons/contest-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View your submissions and statistics",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/icons/dashboard-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-gallery.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "wide",
      "label": "AI Art Gallery - Desktop View"
    },
    {
      "src": "/screenshots/mobile-contest.png",
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow",
      "label": "Active Contests - Mobile View"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "protocol_handlers": [
    {
      "protocol": "web+aiartverse",
      "url": "/share?url=%s"
    }
  ],
  "share_target": {
    "action": "/submit",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "description",
      "files": [
        {
          "name": "artwork",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/submit",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".webp", ".gif"]
      }
    }
  ]
}